# Copy to server/.env and fill in real values. Never commit .env.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/notesapp

# Secret used to sign session JWTs. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-secret

# development | production
NODE_ENV=development

# Allowed browser origin(s) for CORS with cookies, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# SameSite attribute of the auth cookie: lax | strict | none.
# Use "lax" when the client and API are served from the same site (for example
# through a proxy/rewrite). "none" is only needed when the browser calls the API
# on a different site; it forces the Secure flag.
COOKIE_SAMESITE=lax

# How long a login lasts, in days (JWT expiry and cookie max-age).
SESSION_DAYS=7

# bcrypt cost factor.
BCRYPT_SALT_ROUNDS=12

# Optional: where uploaded files are stored (defaults to server/uploads).
# UPLOAD_DIR=
